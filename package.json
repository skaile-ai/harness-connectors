{
  "name": "harness-connectors",
  "private": true,
  "description": "Connectors that link agent harnesses (Claude Code, ...) to Skaile over the harness channel protocol.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/protocol",
    "packages/claude-code"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
