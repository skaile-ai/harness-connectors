{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocolVersion": {
          "type": "string",
          "pattern": "^\\d{1,4}\\.\\d{1,4}$"
        },
        "harnessKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "clientVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "type",
        "id",
        "protocolVersion",
        "harnessKind",
        "clientVersion"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "protocolVersion": {
          "type": "string",
          "pattern": "^\\d{1,4}\\.\\d{1,4}$"
        },
        "remoteAgentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "heartbeatIntervalMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 30000
        },
        "maxFrameBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 262144
        }
      },
      "required": [
        "type",
        "id",
        "replyTo",
        "protocolVersion",
        "remoteAgentId",
        "heartbeatIntervalMs",
        "maxFrameBytes"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ask"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        }
      },
      "required": [
        "type",
        "id",
        "exchangeId",
        "sessionId",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "send"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        }
      },
      "required": [
        "type",
        "id",
        "sessionId",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "answer"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        }
      },
      "required": [
        "type",
        "id",
        "exchangeId",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ack"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "id",
        "replyTo"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exchangeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "enum": [
            "unauthorized",
            "revoked",
            "not_linked",
            "peer_offline",
            "unsupported_version",
            "rate_limited",
            "timeout",
            "invalid_frame",
            "payload_too_large"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "id",
        "code",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ping"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pong"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "id",
        "replyTo"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "peers"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "peers_result"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "peers": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "online": {
                "type": "boolean"
              },
              "agentName": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "sessionId",
              "name",
              "online"
            ]
          }
        }
      },
      "required": [
        "type",
        "id",
        "replyTo",
        "peers"
      ]
    }
  ],
  "title": "Skaile harness channel frame, protocol v1"
}
